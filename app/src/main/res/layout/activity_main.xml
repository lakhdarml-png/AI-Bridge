<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="#121212" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="18dp" android:layoutDirection="rtl">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="NEO-LOCAL" android:textColor="@color/gold" android:textSize="30sp"
   android:textStyle="bold" android:gravity="center" android:layout_marginTop="12dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="لوحة تحكّم الوكيل المحلي" android:textColor="#FFFFFF" android:textSize="18sp"
   android:gravity="center" android:layout_marginBottom="18dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="مجلد مشروع النواة داخل Termux" android:textColor="#CCCCCC" android:textSize="14sp"
   android:layout_marginBottom="6dp"/>
  <EditText android:id="@+id/projectPath" android:layout_width="match_parent"
   android:layout_height="wrap_content"
   android:text="/data/data/com.termux/files/home/neo-local-v1-workflow-test"
   android:singleLine="true" android:textColor="#FFFFFF" android:backgroundTint="@color/gold"
   android:padding="12dp" android:inputType="textNoSuggestions" android:layout_marginBottom="12dp"/>
  <TextView android:id="@+id/coreConnectionStatus" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="حالة الجسر: لم يتم الفحص بعد"
   android:textColor="@color/gold" android:textSize="15sp" android:padding="14dp"
   android:background="#1E1E1E" android:layout_marginBottom="10dp"/>
  <Button android:id="@+id/btnStartBridge" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="تشغيل الجسر" android:textAllCaps="false"
   android:textSize="16sp" android:backgroundTint="@color/gold" android:textColor="#121212"
   android:layout_marginBottom="8dp"/>
  <Button android:id="@+id/btnStopBridge" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="إيقاف الجسر" android:textAllCaps="false"
   android:textSize="16sp" android:backgroundTint="#7A2929" android:textColor="#FFFFFF"
   android:layout_marginBottom="8dp"/>
  <Button android:id="@+id/btnCheckCore" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="فحص اتصال الجسر والنواة"
   android:textAllCaps="false" android:backgroundTint="#294B3B" android:textColor="#FFFFFF"
   android:layout_marginBottom="14dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="سجل الحالة" android:textColor="@color/gold" android:textStyle="bold"
   android:textSize="16sp" android:layout_marginBottom="6dp"/>
  <TextView android:id="@+id/outputResponse" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:minHeight="180dp" android:textColor="#FFFFFF"
   android:textSize="14sp" android:lineSpacingExtra="4dp" android:padding="14dp"
   android:background="#1E1E1E" android:textIsSelectable="true"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="الإعداد الأولي: يحتاج Termux إلى السماح بتشغيل الأوامر من التطبيقات الخارجية ومنح صلاحية RUN_COMMAND. بعد الإعداد، يتم التحكم من هذه اللوحة. كل تشغيل أو إيقاف يتطلب موافقتك."
   android:textColor="#999999" android:textSize="12sp" android:lineSpacingExtra="3dp"
   android:layout_marginTop="14dp" android:layout_marginBottom="12dp"/>
 </LinearLayout>
</ScrollView>
