<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="#121212" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="18dp" android:layoutDirection="rtl">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="NEO-LOCAL" android:textColor="@color/gold" android:textSize="30sp"
   android:textStyle="bold" android:gravity="center" android:layout_marginTop="12dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="النواة المحلية المدمجة" android:textColor="#FFFFFF" android:textSize="18sp"
   android:gravity="center" android:layout_marginBottom="18dp"/>
  <TextView android:id="@+id/coreConnectionStatus" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="حالة النواة: لم يتم الفحص"
   android:textColor="@color/gold" android:textSize="15sp" android:padding="14dp"
   android:background="#1E1E1E" android:layout_marginBottom="10dp"/>
  <Button android:id="@+id/btnCheckCore" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="فحص النواة المدمجة"
   android:textAllCaps="false" android:backgroundTint="@color/gold" android:textColor="#121212"
   android:layout_marginBottom="14dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="إضافة مهمة محلية" android:textColor="@color/gold" android:textStyle="bold"
   android:textSize="16sp" android:layout_marginBottom="6dp"/>
  <EditText android:id="@+id/taskInput" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:hint="اكتب هدف المهمة"
   android:inputType="textMultiLine" android:minLines="2" android:textColor="#FFFFFF"
   android:textColorHint="#999999" android:backgroundTint="@color/gold"
   android:layout_marginBottom="6dp"/>
  <Button android:id="@+id/btnAddTask" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="حفظ المهمة"
   android:textAllCaps="false" android:backgroundTint="#294B3B" android:textColor="#FFFFFF"
   android:layout_marginBottom="14dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="حفظ ذاكرة محلية" android:textColor="@color/gold" android:textStyle="bold"
   android:textSize="16sp" android:layout_marginBottom="6dp"/>
  <EditText android:id="@+id/memoryTitle" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:hint="عنوان الذاكرة"
   android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#999999"
   android:backgroundTint="@color/gold" android:layout_marginBottom="6dp"/>
  <EditText android:id="@+id/memoryContent" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:hint="محتوى الذاكرة"
   android:inputType="textMultiLine" android:minLines="2" android:textColor="#FFFFFF"
   android:textColorHint="#999999" android:backgroundTint="@color/gold"
   android:layout_marginBottom="6dp"/>
  <Button android:id="@+id/btnRemember" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="حفظ الذاكرة"
   android:textAllCaps="false" android:backgroundTint="#294B3B" android:textColor="#FFFFFF"
   android:layout_marginBottom="14dp"/>
  <Button android:id="@+id/btnRecall" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="عرض المهام والذكريات"
   android:textAllCaps="false" android:backgroundTint="#303030" android:textColor="#FFFFFF"
   android:layout_marginBottom="14dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="نتائج النواة" android:textColor="@color/gold" android:textStyle="bold"
   android:textSize="16sp" android:layout_marginBottom="6dp"/>
  <TextView android:id="@+id/outputResponse" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:minHeight="180dp" android:textColor="#FFFFFF"
   android:textSize="14sp" android:lineSpacingExtra="4dp" android:padding="14dp"
   android:background="#1E1E1E" android:textIsSelectable="true"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="هذه النسخة تستدعي Python داخل التطبيق مباشرة. الوصول إلى مجلدات المشاريع الخارجية سيضاف عبر اختيار مجلد وصلاحيات Android، وليس عبر مسارات Termux الخاصة."
   android:textColor="#999999" android:textSize="12sp" android:lineSpacingExtra="3dp"
   android:layout_marginTop="14dp" android:layout_marginBottom="12dp"/>
 </LinearLayout>
</ScrollView>
