<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Bridge | الجسر الذكي"
            android:textColor="@color/gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="انسخ الرد من المساعد، استلمه هنا، ثم انقله للمساعد الآخر. كل رد يظهر باسمه بوضوح."
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:id="@+id/scrollConversation"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:fillViewport="true"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/outputResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textIsSelectable="true" />
        </ScrollView>

        <EditText
            android:id="@+id/inputRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اكتب الرسالة أو تعليمات مراجعة الرد..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="@color/gold"
            android:gravity="top|start"
            android:lines="4"
            android:minLines="4"
            android:maxLines="10"
            android:minHeight="110dp"
            android:padding="12dp"
            android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
            android:scrollbars="vertical"
            android:layout_marginBottom="12dp" />

        <!-- مجموعة ChatGPT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ChatGPT"
            android:textColor="@color/chatgpt_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnSendChatgpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نسخ النص وفتح ChatGPT"
            android:textAllCaps="false"
            android:backgroundTint="@color/chatgpt_blue"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCaptureChatgpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استلام آخر رد من ChatGPT"
            android:textAllCaps="false"
            android:backgroundTint="#1A3A5C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- مجموعة Grok -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grok"
            android:textColor="@color/grok_purple"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnSendGrok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نسخ النص وفتح Grok"
            android:textAllCaps="false"
            android:backgroundTint="@color/grok_purple"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCaptureGrok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استلام آخر رد من Grok"
            android:textAllCaps="false"
            android:backgroundTint="#3A1A5C"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مهم: النسخ واللصق والإرسال داخل التطبيقات يتم بواسطتك. لا يحتاج التطبيق إلى إذن إمكانية الوصول أو مفتاح API أو إنترنت."
            android:textColor="#999999"
            android:textSize="12sp"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
