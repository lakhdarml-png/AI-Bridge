<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Bridge | الجسر الذكي"
            android:textColor="@color/gold"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="انسخ الرد من المساعد، استلمه هنا، ثم انقله للمساعد الآخر. يحتفظ الجسر بسجل الجلسة ويرتب جولات التعاون."
            android:textColor="#DDDDDD"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:id="@+id/scrollConversation"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:fillViewport="true"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/outputResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:textIsSelectable="true" />
        </ScrollView>

        <EditText
            android:id="@+id/inputRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اكتب الرسالة أو تعليمات مراجعة الرد..."
            android:textColor="#FFFFFF"
            android:textColorHint="#999999"
            android:backgroundTint="@color/gold"
            android:gravity="top|start"
            android:minLines="3"
            android:maxLines="8"
            android:inputType="textMultiLine|textCapSentences"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSendChatgpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نسخ النص وفتح ChatGPT"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCaptureChatgpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استلام آخر رد من ChatGPT (بعد نسخه)"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSendGrok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نسخ النص وفتح Grok"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCaptureGrok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استلام آخر رد من Grok (بعد نسخه)"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مهم: النسخ واللصق والإرسال داخل ChatGPT وGrok يتم بواسطتك. لا يحتاج التطبيق إلى إذن إمكانية الوصول أو مفتاح API."
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>