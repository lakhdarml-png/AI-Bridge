<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bridge_ready"
            android:textColor="@color/gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bridge_instructions"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="10dp" />

        <ScrollView
            android:id="@+id/scrollConversation"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:fillViewport="true"
            android:background="#1E1E1E"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/outputResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:padding="8dp"
                android:textIsSelectable="true" />
        </ScrollView>

        <EditText
            android:id="@+id/inputRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اكتب رسالة لنقلها إلى أحد المساعدين"
            android:textColor="@color/white"
            android:textColorHint="#888888"
            android:backgroundTint="@color/gold"
            android:gravity="top|start"
            android:minLines="2"
            android:maxLines="5"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btnSendChatgpt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="نسخ وفتح ChatGPT"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/btnSendGrok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="نسخ وفتح Grok"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnCaptureChatgpt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="التقاط من ChatGPT"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/btnCaptureGrok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="التقاط من Grok"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفعيل خدمة الالتقاط من إعدادات Android"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="معالجة محلية (ليست نموذج ذكاء اصطناعي)"
            android:textAllCaps="false"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>